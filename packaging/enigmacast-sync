#!/bin/sh
# EnigmaCast Sync API. Does not touch Enigma2, OSCam, tuner or bouquet settings.
DAEMON=/usr/bin/python3
PLUGIN=/usr/lib/enigma2/python/Plugins/Extensions/EnigmaCastSync
# cron runs the watchdog with a minimal PATH; start-stop-daemon lives in /sbin.
PATH=/sbin:/usr/sbin:/bin:/usr/bin:$PATH
CMD=serve

is_mount() {
    d=$1
    if command -v findmnt >/dev/null 2>&1; then
        findmnt -n "$d" >/dev/null 2>&1
    else
        awk -v p="$d" '$2 == p { found=1 } END { exit found ? 0 : 1 }' /proc/mounts
    fi
}

pick_dir() {
    # Must match enigmacast_sync.storage.choose_data_dir.
    for d in /media/hdd /media/usb /media/mmc /media/cf; do
        if is_mount "$d" && [ -w "$d" ] && [ -f "$d/enigmacast-sync/sync.db" ]; then
            echo "$d/enigmacast-sync"
            return 0
        fi
    done
    for d in /media/hdd /media/usb /media/mmc /media/cf; do
        if is_mount "$d" && [ -w "$d" ]; then
            echo "$d/enigmacast-sync"
            return 0
        fi
    done
    # 0.2.4 and older used /media/<x> without checking the mount: keep that database.
    if [ ! -f /etc/enigmacast-sync/sync.db ]; then
        for d in /media/hdd /media/usb /media/mmc /media/cf; do
            if [ -f "$d/enigmacast-sync/sync.db" ] && [ -w "$d/enigmacast-sync" ]; then
                echo "$d/enigmacast-sync"
                return 0
            fi
        done
    fi
    echo /etc/enigmacast-sync
}

prepare() {
    mkdir -p "$DIR/logs" "$DIR/backups"
    if [ "$(id -u)" -eq 0 ]; then
        if [ -f /var/run/enigmacast-sync.pid ]; then
            kill "$(cat /var/run/enigmacast-sync.pid)" 2>/dev/null || true
            rm -f /var/run/enigmacast-sync.pid
        fi
        id enigmacast >/dev/null 2>&1 && chown -R enigmacast "$DIR" 2>/dev/null || true
    fi
}

is_sync() {
    cmd=$(tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null || true)
    case "$cmd" in
        *" serve-web"*) return 1 ;;
        *" serve "*) return 0 ;;
        *" serve") return 0 ;;
    esac
    return 1
}

running() {
    [ -f "$PID" ] || return 1
    pidn=$(cat "$PID" 2>/dev/null || true)
    [ -n "$pidn" ] || return 1
    [ -r "/proc/$pidn/cmdline" ] || return 1
    is_sync "$pidn"
}

stop_pid() {
    [ -f "$PID" ] || return 0
    pidn=$(cat "$PID" 2>/dev/null || true)
    case "$pidn" in
        ''|*[!0-9]*) rm -f "$PID"; return 0 ;;
    esac
    if [ -r "/proc/$pidn/cmdline" ] && is_sync "$pidn"; then
        kill "$pidn" 2>/dev/null || true
        sleep 1
        if [ -r "/proc/$pidn/cmdline" ] && is_sync "$pidn"; then
            kill -9 "$pidn" 2>/dev/null || true
        fi
    fi
    rm -f "$PID"
}

stop_matches() {
    for proc in /proc/[0-9]*; do
        pidn=${proc#/proc/}
        [ -r "$proc/cmdline" ] || continue
        cmd=$(tr '\0' ' ' < "$proc/cmdline" 2>/dev/null || true)
        case "$cmd" in
            *serve-web*) continue ;;
        esac
        case "$cmd" in
            *enigmacast_sync.cli*) kill "$pidn" 2>/dev/null || true ;;
        esac
    done
}

any_running() {
    # Any instance, also one started with another data directory (a disk mounted later).
    for proc in /proc/[0-9]*; do
        [ -r "$proc/cmdline" ] || continue
        cmd=$(tr '\0' ' ' < "$proc/cmdline" 2>/dev/null || true)
        case "$cmd" in
            *serve-web*) continue ;;
        esac
        case "$cmd" in
            *enigmacast_sync.cli*) return 0 ;;
        esac
    done
    return 1
}

rotate_log() {
    # sync.log receives stdout/stderr of the Sync API for months. Rotate it while the API is
    # stopped (it holds the file open): above 1 MiB it becomes sync.log.1.
    log=$DIR/logs/sync.log
    [ -f "$log" ] || return 0
    size=$(wc -c < "$log" 2>/dev/null || echo 0)
    if [ "${size:-0}" -gt 1048576 ]; then
        mv -f "$log" "$log.1" 2>/dev/null || true
    fi
}

launch() {
    id enigmacast >/dev/null 2>&1 || { echo "user enigmacast is missing"; exit 1; }
    rotate_log
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -S -b -m -p "$PID" -x "$PLUGIN/sync-run" -- "$DIR"
        return
    fi
    echo "start-stop-daemon is required"
    exit 1
}

DIR=$(pick_dir)
PID=$DIR/enigmacast-sync.pid
# Written by "stop" (also the dashboard Stop button), removed by start/restart: the watchdog
# leaves a service alone that was stopped on purpose. Reboot runs "start" and clears it.
STOPPED=$DIR/enigmacast-sync.stopped
case "$1" in
start)
    prepare
    rm -f "$STOPPED"
    running && exit 0
    rm -f "$PID"
    launch
    ;;
stop)
    prepare
    touch "$STOPPED" 2>/dev/null || true
    stop_pid
    stop_matches
    ;;
restart)
    prepare
    rm -f "$STOPPED"
    stop_pid
    stop_matches
    sleep 1
    launch
    ;;
watchdog)
    # Every minute from cron. Cheap when all is well: no mkdir/chown, only a /proc scan.
    [ -f "$STOPPED" ] && exit 0
    running && exit 0
    any_running && exit 0
    prepare
    rm -f "$PID"
    echo "$(date '+%Y-%m-%d %H:%M:%S') watchdog: enigmacast-sync was not running, starting it" >> "$DIR/logs/sync.log" 2>/dev/null || true
    launch
    ;;
*)
    echo "Usage: $0 {start|stop|restart|watchdog}"
    exit 1
    ;;
esac
